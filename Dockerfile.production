# ─────────────────────────────────────────────────
# Stage 1: Build
# ─────────────────────────────────────────────────
FROM node:20-alpine AS builder

ARG ENVIRONMENT=dev
ARG FONTAWESOME_AUTHTOKEN

WORKDIR /app

# Auth token for FontAwesome Pro (if used)
RUN if [ -n "$FONTAWESOME_AUTHTOKEN" ]; then \
      npm config set "@fortawesome:registry" "https://npm.fontawesome.com/" && \
      npm config set "//npm.fontawesome.com/:_authToken" "$FONTAWESOME_AUTHTOKEN"; \
    fi

COPY package*.json ./
RUN npm ci --prefer-offline

COPY . .

# Inject environment at build time
ENV VITE_ENVIRONMENT=$ENVIRONMENT

RUN npm run build -- --mode $ENVIRONMENT

# ─────────────────────────────────────────────────
# Stage 2: Serve
# ─────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Copy nginx config
COPY app/nginx.conf /etc/nginx/nginx.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Lightweight health-check
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
